{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "strategy-selection-frame.schema.json",
  "title": "StrategySelectionFrame",
  "description": "Output shape for the dynamic-reasoning selector agent. Recommends a reasoning skill id from the reasoning catalog for a given task.",
  "type": "object",
  "required": ["kind", "selected_strategy", "reasoning_catalog_path", "rationale"],
  "properties": {
    "kind": {"type": "string", "pattern": "SelectionFrame$"},
    "selected_strategy": {"type": "string", "minLength": 1},
    "reasoning_catalog_path": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "alternatives_considered": {"type": "array", "items": {"type": "string"}},
    "family": {"type": "string"}
  },
  "additionalProperties": true
}
