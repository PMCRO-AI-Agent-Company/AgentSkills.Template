{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmcro.ai/schemas/agent-scaffold-spec.json",
  "title": "PMCRO Agent Scaffold Spec",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "pmcro.ai/v1" },
    "kind": { "const": "AgentScaffoldSpec" },
    "metadata": {
      "type": "object",
      "required": ["id", "kind", "display_name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "kind": { "type": "string", "enum": ["lifecycle", "persona", "domain", "tool", "marketplace-scaffold", "harness"] },
        "display_name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["description", "packaging"],
      "properties": {
        "description": { "type": "string", "minLength": 20 },
        "owner_role": { "type": "string", "minLength": 1 },
        "tier": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "laws": { "type": "array", "items": { "type": "string" } },
        "permissions": {
          "type": "object",
          "properties": {
            "may": { "type": "array", "items": { "type": "string" } },
            "mayNot": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "required": ["schema_ref", "contract"],
          "properties": {
            "schema_ref": { "type": "string" },
            "contract": { "type": "string" }
          },
          "additionalProperties": false
        },
        "reasoning": {
          "type": "object",
          "properties": {
            "allowed_families": { "type": "array", "items": { "type": "string" } },
            "default": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "packaging": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["target"],
            "properties": {
              "target": { "type": "string", "enum": ["agentskills", "maf-inline", "maf-class", "claude-plugin", "cursor-plugin", "codex-plugin"] },
              "path": { "type": "string" },
              "language": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": {
              "name": { "type": "string" },
              "tier": { "type": "string" },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "evaluation": {
          "type": "object",
          "properties": {
            "must_pass": { "type": "array", "items": { "type": "string" } },
            "trials": { "type": "integer", "minimum": 1 },
            "must_refuse": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
