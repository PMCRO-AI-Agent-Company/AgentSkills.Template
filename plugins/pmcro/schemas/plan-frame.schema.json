{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plan-frame.schema.json",
  "title": "PlanFrame",
  "type": "object",
  "required": ["role", "goal", "success_criteria", "steps"],
  "properties": {
    "role": {"const": "planner"},
    "goal": {"type": "string", "minLength": 1},
    "success_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "properties": {
          "id": {"type": "string"},
          "action": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": false
}
