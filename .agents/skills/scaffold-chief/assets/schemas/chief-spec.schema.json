{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmcro.ai/schemas/chief-spec.json",
  "title": "PMCRO Chief Spec",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "pmcro.ai/v1" },
    "kind": { "const": "ChiefSpec" },
    "metadata": {
      "type": "object",
      "required": ["id", "abbreviation", "display_name", "version", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^pmcro-chief-[a-z0-9]+(-[a-z0-9]+)*$" },
        "abbreviation": { "type": "string", "minLength": 2, "maxLength": 6 },
        "display_name": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string", "enum": ["experimental", "stable", "deprecated"] }
      }
    },
    "spec": {
      "type": "object",
      "required": ["domain", "intent_frame_kind", "description", "omode", "packaging"],
      "properties": {
        "domain": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "intent_frame_kind": { "type": "string", "pattern": "^[A-Z][a-zA-Z]+IntentFrame$" },
        "description": { "type": "string", "minLength": 20 },
        "when_to_use": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "omode": {
          "type": "object",
          "required": ["modes", "default_reasoning_strategy"],
          "properties": {
            "modes": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "required": ["trigger", "reasoning_strategy", "frame_shape"],
                "properties": {
                  "trigger": { "type": "string" },
                  "reasoning_strategy": { "type": "string" },
                  "frame_shape": { "type": "string" },
                  "notes": { "type": "string" }
                }
              }
            },
            "default_reasoning_strategy": { "type": "string" }
          }
        },
        "packaging": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["target", "path"],
            "properties": {
              "target": { "type": "string", "enum": ["agentskills", "maf-inline", "maf-class"] },
              "path": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
